# Development defaults: no production AI calls from the development-user account.
# Production uses the authenticated SWA-linked /api/openai/chat/completions route.
# Endpoint, API version, and credentials belong on the backend, NEVER in REACT_APP_*.
REACT_APP_AI_ENABLED=false
REACT_APP_AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Optional local Functions target. Use a local SWA emulator for authenticated API testing.
# REACT_APP_FUNCTION_BASE_URL=http://localhost:7071

# DEPRECATED: Azure AD Configuration for Microsoft Sign-In
# Azure Static Web Apps FREE tier handles authentication automatically via /.auth endpoints
# using built-in pre-configured providers. No custom app registration required.
# The following variables are no longer required but kept for reference:
# REACT_APP_AZURE_AD_CLIENT_ID=YOUR_AZURE_AD_CLIENT_ID
# REACT_APP_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/common
# REACT_APP_REDIRECT_URI=http://localhost:3000

# Authentication Mode
# Set to false to enable Microsoft Sign-In authentication in production (uses built-in AAD provider)
# Set to true for development mode (bypasses authentication)
REACT_APP_SKIP_AUTH=true

# Leave cloud sync disabled for local development. Never send development-user data to production.
# Enable only in a signed-in deployment linked to the protected API in api/.
REACT_APP_CLOUD_SYNC_ENABLED=false

# Application Settings
REACT_APP_NAME=Mo Money
REACT_APP_VERSION=1.0.0
